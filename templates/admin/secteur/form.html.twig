{% extends 'base.html.twig' %}

{% block title %}
  Modifier {{ secteur.nom }} — La Réglette
{% endblock %}

{% block body %}
  <main class="sheet sheet-narrow">
    <header class="sheet-heading">
      <p class="section-index">
        Admin
      </p>
      <h1>Modifier le secteur</h1>
    </header>

    {{ form_start(form) }}
    {{ form_errors(form) }}
    {{ form_row(form.nom) }}
    <button class="button" type="submit">Enregistrer</button>
    {{ form_end(form) }}
    <p>
      <a href="{{ path('app_admin_secteur_index') }}">Retour aux secteurs</a>
    </p>
  </main>
{% endblock %}
