<header class="topbar">
  <a class="brand" href="{{ path('app_home') }}">La Réglette</a>
  <nav class="topbar-links">
    {% if app.user %}
      <a class="button" href="{{ path('app_profil') }}">Profil</a>
      <a class="button button-quiet" href="{{ path('app_logout') }}">Se déconnecter</a>
    {% else %}
      <a class="button" href="{{ path('app_login') }}">Se connecter</a>
      <a class="button button-quiet" href="{{ path('app_register') }}">Inscription</a>
    {% endif %}
  </nav>
</header>
