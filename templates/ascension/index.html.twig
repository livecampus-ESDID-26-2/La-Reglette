{% extends 'base.html.twig' %}

{% block title %}
  Mes réussites — La Réglette
{% endblock %}

{% block body %}
  <main class="sheet">
    <header class="sheet-heading">
      <p class="section-index">
        Carnet
      </p>
      <h1>Mes réussites</h1>
    </header>

    <table class="data">
      <thead>
        <tr>
          <th>Date</th>
          <th>Bloc</th>
          <th>Cotation</th>
          <th>Secteur</th>
          <th>Note</th>
          <th>Commentaire</th>
          <th></th>
        </tr>
      </thead>
      <tbody>
        {% for ascension in ascensions %}
          <tr>
            <td>{{ ascension.dateReussite|date('d/m/Y') }}</td>
            <td>
              <a
                href="{{
                path(
                  'app_bloc_show',
                  {
                    id: ascension.bloc.id
                  }
                )
                }}"
              >
                {{ ascension.bloc.nom }}
              </a>
              {% if not ascension.bloc.enPlace %}
                <span class="tag">démonté</span>
              {% endif %}
            </td>
            <td>{{ ascension.bloc.cotation.label }}</td>
            <td>{{ ascension.bloc.secteur.nom }}</td>
            <td>{{ ascension.note }}</td>
            <td>{{ ascension.commentaire }}</td>
            <td>
              <form
                method="post"
                action="{{
                path(
                  'app_ascension_delete',
                  {
                    id: ascension.id
                  }
                )
                }}"
              >
                <input type="hidden" name="_token" value="{{ csrf_token('supprimer' ~ ascension.id) }}" />
                <button class="button button-quiet" type="submit">Supprimer</button>
              </form>
            </td>
          </tr>
        {% else %}
          <tr>
            <td colspan="7">Aucune réussite enregistrée.</td>
          </tr>
        {% endfor %}
      </tbody>
    </table>
  </main>
{% endblock %}
