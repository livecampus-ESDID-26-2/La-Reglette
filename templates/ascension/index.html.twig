{% extends 'base.html.twig' %}

{% block title %}
  Mes réussites — La Réglette
{% endblock %}

{% block body %}
  <main class="sheet">
    <header class="sheet-heading">
      <p class="section-index">
        Carnet
      </p>
      <h1>Mes réussites</h1>
      <p class="sheet-count">
        {{ ascensions|length }} enregistrées.
      </p>
    </header>

    <div class="board">
      <table class="data">
        <thead>
          <tr>
            <th>Date</th>
            <th>Bloc</th>
            <th>Cotation</th>
            <th>Secteur</th>
            <th class="num">Note</th>
            <th>Commentaire</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          {% for ascension in ascensions %}
            <tr>
              <td class="meta">{{ ascension.dateReussite|date('d/m/Y') }}</td>
              <td>
                <a
                  class="name"
                  href="{{
                  path(
                    'app_bloc_show',
                    {
                      id: ascension.bloc.id
                    }
                  )
                  }}"
                >
                  {{ ascension.bloc.nom }}
                </a>
                {% if not ascension.bloc.enPlace %}
                  <span class="tag">démonté</span>
                {% endif %}
              </td>
              <td><span class="grade">{{ ascension.bloc.cotation.label }}</span></td>
              <td>{{ ascension.bloc.secteur.nom }}</td>
              <td class="num">{{ ascension.note }}<span class="meta">/5</span></td>
              <td class="comment">{{ ascension.commentaire }}</td>
              <td>
                <form
                  class="inline-form"
                  method="post"
                  action="{{
                  path(
                    'app_ascension_delete',
                    {
                      id: ascension.id
                    }
                  )
                  }}"
                >
                  <input type="hidden" name="_token" value="{{ csrf_token('supprimer' ~ ascension.id) }}" />
                  <button class="button button-quiet" type="submit">Supprimer</button>
                </form>
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="7">Aucune réussite enregistrée.</td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>
  </main>
{% endblock %}
